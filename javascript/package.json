{
  "name": "@joookiwi/lazy",
  "version": "1.7.3",
  "description": "A Javascript implementation based of the Kotlin lazy with reusable fields",

  "scripts": {
    "clear-dist-folder": "del-cli dist/",
    "build-esm":   "tsc --project tsconfig.esm.json",
    "build-cjs":   "tsc --project tsconfig.cjs.json",
    "build-types": "tsc --project tsconfig.types.json",

    "test":                "vitest run",
    "test-with-coverage":  "vitest run --coverage",
    "test-initialized":    "vitest run --testNamePattern=InitializedLazyTest",
    "test-implementation": "vitest run --testNamePattern=LazyImplementationTest",
    "see-import-duration": "vitest --experimental.importDurations.print",

    "test-pack":    "npm pack --dry-run",
    "test-publish": "npm publish --@access=public --dry-run",

    "pack": "npm pack",

    "local-publish":  "npm link",
    "publish-to-npm": "npm publish --access=public"
  },

  "directories": {
    "lib": "./src",
    "test": "./test"
  },
  "main": "./dist/common javascript/index.js",
  "module": "./dist/ecmascript module/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    "types":   "./dist/types/index.d.ts",
    "import":  "./dist/ecmascript module/index.js",
    "require": "./dist/common javascript/index.js"
  },

  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joooKiwi/lazy.git"
  },
  "bugs": {
    "url": "https://github.com/joooKiwi/lazy/issues"
  },

  "keywords": [
    "lazy",
    "kotlin lazy",
    "lazy pattern",
    "object holder"
  ],
  "funding": [
    { "type": "github",          "url": "https://github.com/sponsors/joooKiwi" },
    { "type": "buy-me-a-coffee", "url": "https://www.buymeacoffee.com/joookiwi" }
  ],
  "author": "JóôòKiwi",
  "license": "MIT",
  "dependencies": {
    "@joookiwi/type": "^1.2.2"
  },
  "devDependencies": {
    "@types/node":         "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "del-cli":             "^7.0.0",
    "jest-extended":       "^7.0.0",
    "ts-node":             "^10.9.2",
    "typescript":          "^7.0.2",
    "vitest":              "^4.1.11"
  }
}
